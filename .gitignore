# Rust build output — two workspaces, host at the root and firmware/ cross-compiled
/target/
/firmware/target/

# Nix
/result
/result-*
.direnv/

# Ralph loop runtime state: per-run and machine-local, not project configuration.
# The rest of .pi/ (agents, prompts, skills, the extension) IS project config and
# is tracked.
.pi/ralph/

# Autonomous pi/ralph loop state (role.json etc.): per-run and machine-local,
# same reasoning as .pi/ralph/ above.
.agents/
# DFU images from firmware/Makefile, named after the binary each came from (`main.bin`,
# `rig.bin`). The bare `firmware.bin` is the name every image used before TASK-038.03.02.03.
/firmware/*.bin
firmware.bin
